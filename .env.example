# ==============================================================================
# AI-Powered E-Commerce Feasibility Advisor & Auto Store Generator
# Environment Configuration Template
# ==============================================================================

# Supabase Public API Configuration
# Get these from the Supabase project Connect dialog. Prefer the publishable key;
# the legacy anon key name remains supported by the app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key-here

# Supabase Server-Only Service Role Key (Privileged operations: account delete & admin seed)
# WARNING: NEVER expose this to client-side bundles or repository commits.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional server-only AI provider credentials. A provider is used only when
# BOTH its API key and model are set; leave unused providers blank. Never use
# NEXT_PUBLIC_ for any value in this block.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_PROMPT_VERSION=v1
AI_USER_HOURLY_QUOTA=20
# Optional server-only task policy overrides. Values are comma-separated
# provider names from: openai,gemini,groq. Invalid entries are ignored.
AI_ADVISORY_PROVIDERS=openai,gemini,groq

# Optional server-only Stripe secret. Payments remain unconfigured without this
# key and a Stripe account configured in application settings.
STRIPE_SECRET_KEY=

# Admin Bootstrap / Seed Admin Credentials (FR-1.5)
# Used only by scripts/seed-admin.mjs to initialize or reconcile the initial administrator.
INITIAL_ADMIN_EMAIL=admin@your-domain.pk
INITIAL_ADMIN_PASSWORD=change-me-immediately

# Admin GitHub Configuration REST Sync (FR-1.6)
# Server-only personal access token with 'repo' scope for pushing system config snapshots.
GITHUB_SYNC_TOKEN=ghp_your-github-pat-here
GITHUB_SYNC_REPO=your-username/your-repo
GITHUB_SYNC_BRANCH=main

# Application URL
NEXT_PUBLIC_APP_URL=https://ai-e-commerce-advisor-auto-store-ge-plum.vercel.app/

# ==============================================================================
# Module 4: ML Microservice Authentication (Server-Only Secret)
# ==============================================================================
# ML Microservice secret key (constant-time compared; min 32 chars in production).
# Generate with: openssl rand -hex 32 and replace the placeholder below. The
# placeholder is on both fail-closed denylists and will not start the service.
ML_SERVICE_API_KEY=your-secure-ml-service-api-key-here
ML_SERVICE_URL=http://127.0.0.1:8000
# ==============================================================================
# Module 3: Data Collection & Provider Configuration
# ==============================================================================

# OpenStreetMap Overpass API Endpoint (Defaults to public Overpass interpreter)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_API_TIMEOUT_MS=12000

# Force Demo Mode ('true' | 'false') to test offline deterministic synthetic data
FORCE_DEMO_DATA=false

# Scheduled cron authorization (server-only). Required for /api/cron/rent-cache.
# Send as: Authorization: Bearer <CRON_SECRET>  or  x-cron-secret: <CRON_SECRET>
CRON_SECRET=change-me-to-a-long-random-cron-secret
