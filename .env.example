# ==============================================================================
# AI-Powered E-Commerce Feasibility Advisor & Auto Store Generator
# Environment Configuration Template
# ==============================================================================

# Supabase Public API Configuration
# Get these from the Supabase project Connect dialog. Prefer the publishable key;
# the legacy anon key name remains supported by the app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key-here

# Supabase Server-Only Service Role Key (Privileged operations: account delete & admin seed)
# WARNING: NEVER expose this to client-side bundles or repository commits.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Server-only AI provider credentials. Configure model IDs in the provider console.
# Never add the NEXT_PUBLIC_ prefix to these values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=

# Admin Bootstrap / Seed Admin Credentials (FR-1.5)
# Used only by scripts/seed-admin.mjs to initialize or reconcile the initial administrator.
INITIAL_ADMIN_EMAIL=admin@your-domain.pk
INITIAL_ADMIN_PASSWORD=change-me-immediately

# Admin GitHub Configuration REST Sync (FR-1.6)
# Server-only personal access token with 'repo' scope for pushing system config snapshots.
GITHUB_SYNC_TOKEN=ghp_your-github-pat-here
GITHUB_SYNC_REPO=your-username/your-repo
GITHUB_SYNC_BRANCH=main

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# Module 3: Data Collection & Provider Configuration
# ==============================================================================

# OpenStreetMap Overpass API Endpoint (Defaults to public Overpass interpreter)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_API_TIMEOUT_MS=12000

# Force Demo Mode ('true' | 'false') to test offline deterministic synthetic data
FORCE_DEMO_DATA=false
